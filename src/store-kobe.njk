---
# 神戸業態LP（Kobe Beef）
# - stores.json の category: "kobe" の店舗 × 言語ごとに1ページ生成（データは _data/kobePages.js）
# - 計測要件（docs: LP作成プロンプト.md）
#   ・予約CTAは必ず <a href>。TableCheck URL は stores.json の reserveUrl をそのまま（UTMを付けない／/reserve/message 等の最終URL）
#   ・reserveUrl が空の店舗は全CTAが tel: + tel_click に切り替わる
#   ・dataLayer.push は head の店舗情報と [data-ga-event] ハンドラの2か所だけ
#   ・ACQ-FORWARD（partials/acq-forward.njk）と GTM（head / body 直後）を消さない
pagination:
  data: kobePages
  size: 1
  alias: p
permalink: "{{ p.url }}index.html"
eleventyExcludeFromCollections: true
---
{%- set store = p.store -%}
{%- set t = p.t -%}
{%- set reserveAttrs = 'target="_blank" rel="noopener"' if p.reserve.external else '' -%}
{%- set ig = store.instagramUrl or stores.defaults.instagramUrl -%}
<!DOCTYPE html>
<html lang="{{ p.langMeta.htmlLang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ p.h1 }} | {{ t.halalBadge }}</title>
<meta name="description" content="{{ store.description if p.lang == 'en' else (p.h1 + '. ' + t.halalBadge + '.') }}">
<link rel="canonical" href="{{ p.canonical }}">
{%- for a in p.alternates %}
<link rel="alternate" hreflang="{{ a.hreflang }}" href="{{ a.abs }}">
{%- endfor %}
<link rel="alternate" hreflang="x-default" href="{{ p.xDefault }}">
<meta property="og:type" content="restaurant">
<meta property="og:title" content="{{ p.h1 }}">
<meta property="og:image" content="https://halal-food-wagyu.com/image/kobe/{{ store.heroImage }}">

<!-- Google Tag Manager -->
<script>
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({
    store_name: '{{ store.gaStoreName }}',
    store_area: '{{ store.region }}',
    brand: 'kobe-beef',
    channel: 'map'
  });
</script>
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-5DGT9H6L');</script>
<!-- End Google Tag Manager -->

<script type="application/ld+json">{{ p.jsonld | dump | safe }}</script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Noto+Sans:wght@400;500;700{% if p.langMeta.cjkFont %}&family={{ p.langMeta.cjkFont | replace(' ', '+') }}:wght@400;500;700{% endif %}&display=swap" rel="stylesheet">

<style>
:root{
  --bg:#120E0B; --bg-deep:#0B0907; --surface:#1C1612;
  --gold:#D4AF63; --gold-light:#EBD3A0; --line:#5C4A2A; --line-soft:#3A2F22;
  --text:#F3EDE4; --muted:#B3A898;
  --red:#B42318; --red-ink:#FFFFFF;
  --display:'Oswald'{% if p.langMeta.cjkFont %},'{{ p.langMeta.cjkFont }}'{% endif %},sans-serif;
  --body:'Noto Sans'{% if p.langMeta.cjkFont %},'{{ p.langMeta.cjkFont }}'{% endif %},system-ui,sans-serif;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:150px}
body{margin:0;background:var(--bg-deep);color:var(--text);font-family:var(--body);font-size:16px;line-height:1.55}
a{color:var(--gold-light)}
a:hover{color:#FFFFFF}
img{display:block;max-width:100%}
.kb-page{max-width:560px;margin:0 auto;background:var(--bg)}
.kb-cta{display:flex;align-items:center;justify-content:center;gap:10px;min-height:56px;border-radius:4px;background:var(--red);color:var(--red-ink);text-decoration:none;font-family:var(--display);font-weight:600;font-size:18px;letter-spacing:.08em;text-transform:uppercase}
.kb-cta:hover{color:var(--red-ink);filter:brightness(1.08)}
.kb-cta--sm{display:inline-flex;min-height:44px;padding:0 14px;font-size:15px}
.kb-ghost{display:flex;align-items:center;justify-content:center;gap:8px;min-height:48px;border:1px solid var(--line);border-radius:4px;color:var(--gold-light);text-decoration:none;font-family:var(--display);font-weight:500;letter-spacing:.08em;text-transform:uppercase}
.kb-h2{margin:0;padding-bottom:10px;border-bottom:2px solid var(--gold);font-family:var(--display);font-weight:600;font-size:28px;line-height:1.15;letter-spacing:.06em;text-transform:uppercase;color:var(--gold-light)}
.kb-section{display:flex;flex-direction:column;gap:16px;padding:36px 16px}
.kb-section--alt{background:var(--surface)}
/* header */
.kb-header{position:sticky;top:0;z-index:20;background:var(--bg-deep);border-bottom:1px solid var(--line)}
/* ヘッダー：狭い画面は「KOBE BEEF＋ボタン」の下に店名を全幅。広い画面は KOBE BEEF と店名を左に縦積み、ボタンは2行の中央 */
.kb-header__bar{display:grid;grid-template-columns:minmax(0,1fr) auto;grid-template-areas:"brand actions" "store store";column-gap:12px;row-gap:6px;padding:8px 14px 10px}
.kb-brand{grid-area:brand;align-self:center;display:flex;align-items:center;gap:10px;text-decoration:none}
.kb-brand__name{display:block;font-family:'Oswald',sans-serif;font-weight:600;font-size:18px;letter-spacing:.1em;color:var(--gold);line-height:1}
.kb-header__store{grid-area:store;margin:0;font-size:12px;font-weight:500;line-height:1.4;color:var(--text);word-break:keep-all;overflow-wrap:anywhere}
.kb-header__actions{grid-area:actions;display:flex;align-items:center;gap:8px}
@media (min-width:480px){
  .kb-header__bar{grid-template-areas:"brand actions" "store actions";row-gap:4px;padding:10px 16px}
  .kb-brand{align-self:end}
  .kb-header__actions{align-self:center}
  .kb-header__store{align-self:start;font-size:13px}
}
.kb-lang{position:relative}
.kb-lang summary{display:inline-flex;align-items:center;gap:6px;min-height:44px;padding:0 10px;border:1px solid var(--line);border-radius:4px;color:var(--gold-light);font:500 14px 'Oswald',sans-serif;letter-spacing:.06em;cursor:pointer;list-style:none}
.kb-lang summary::-webkit-details-marker{display:none}
.kb-lang__list{position:absolute;right:0;top:calc(100% + 6px);min-width:170px;margin:0;padding:6px 0;list-style:none;background:var(--bg-deep);border:1px solid var(--line);border-radius:4px}
.kb-lang__list a{display:flex;justify-content:space-between;align-items:center;min-height:44px;padding:0 14px;text-decoration:none;color:var(--text)}
.kb-lang__list a[aria-current="true"]{color:var(--gold)}
.kb-nav{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid var(--line-soft)}
.kb-nav a{display:flex;align-items:center;justify-content:center;min-height:40px;text-decoration:none;font-family:var(--display);font-size:14px;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--gold-light)}
/* hero */
.kb-hero__img{width:100%;height:280px;object-fit:cover;object-position:50% 40%;background:var(--bg-deep)}
.kb-hero__body{display:flex;flex-direction:column;gap:14px;padding:22px 16px 26px}
.kb-kicker{font-family:var(--display);font-size:13px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold)}
.kb-h1{margin:0;font-family:var(--display);font-weight:700;font-size:40px;line-height:1.06;letter-spacing:.02em;text-transform:uppercase;color:#FFFFFF}
.kb-rule{height:1px;background:var(--gold)}
.kb-badge{display:inline-flex;align-self:flex-start;align-items:center;gap:8px;padding:6px 12px;border:1px solid var(--gold);border-radius:999px;color:var(--gold-light);font-size:13px;font-weight:700}
.kb-chips{display:flex;flex-wrap:wrap;gap:8px}
.kb-chip{padding:4px 10px;border:1px solid var(--line);border-radius:999px;font-size:12px;font-weight:600;letter-spacing:.04em;color:var(--muted)}
.kb-note{margin-top:-6px;text-align:center;font-size:13px;color:var(--muted)}
.kb-pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
/* info strip */
.kb-info{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:var(--line);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.kb-info div{display:flex;flex-direction:column;gap:2px;padding:14px 8px;background:var(--bg-deep);text-align:center}
.kb-info span{font-size:12px;color:var(--muted)}
.kb-info strong{font-size:14px}
/* menu */
.kb-cards{display:flex;flex-direction:column;gap:18px}
.kb-card{border:1px solid var(--line-soft);border-radius:4px;background:var(--surface);overflow:hidden}
.kb-card img{width:100%;height:auto;aspect-ratio:16/10;object-fit:cover}
.kb-card__body{display:flex;flex-direction:column;gap:4px;padding:14px 16px 16px;border-top:2px solid var(--gold)}
.kb-card__title{font-family:var(--display);font-weight:600;font-size:22px;line-height:1.2;letter-spacing:.04em;text-transform:uppercase;color:#FFFFFF}
.kb-card__desc{font-size:14px;color:var(--muted)}
.kb-combo{text-align:center;font-family:var(--display);letter-spacing:.06em;color:var(--gold-light)}
.kb-halal-note{margin:0;padding:12px 14px;border:1px solid var(--line);border-radius:4px;font-size:14px;color:var(--gold-light)}
/* about */
.kb-about-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.kb-about-grid div{display:flex;flex-direction:column;gap:2px;padding:14px;border:1px solid var(--line-soft);border-radius:4px;background:var(--bg)}
.kb-about-grid strong{font-size:15px}
.kb-about-grid span{font-size:13px;color:var(--muted)}
/* access */
.kb-table{display:flex;flex-direction:column;padding:4px 14px;border:1px solid var(--line-soft);border-radius:4px;background:var(--bg)}
.kb-table div{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid var(--line-soft);font-size:15px}
.kb-table div:last-child{border-bottom:0}
.kb-map{width:100%;height:240px;border:0;border-radius:4px}
.kb-address{display:flex;flex-direction:column;gap:4px;font-size:15px}
/* faq */
.kb-faq{display:flex;flex-direction:column;border-top:1px solid var(--line-soft)}
.kb-faq details{padding:14px 0;border-bottom:1px solid var(--line-soft)}
.kb-faq summary{cursor:pointer;font-weight:700}
.kb-faq p{margin:8px 0 0;font-size:15px;color:var(--muted)}
/* footer */
.kb-footer{display:flex;flex-direction:column;gap:12px;padding:28px 16px 96px;background:var(--bg-deep);border-top:1px solid var(--line);font-size:13px;color:var(--muted)}
.kb-footer strong{color:var(--gold-light);font-size:14px}
/* floating CTA */
.kb-float{position:fixed;left:0;right:0;bottom:0;z-index:30;display:flex;justify-content:center;background:rgba(11,9,7,.96);border-top:1px solid var(--line)}
.kb-float__inner{display:flex;gap:8px;width:100%;max-width:560px;padding:10px 12px}
.kb-float__tel{display:flex;align-items:center;justify-content:center;flex:0 0 52px;min-height:52px;border:1px solid var(--line);border-radius:4px;color:var(--gold-light)}
.kb-float .kb-cta{flex:1 1 auto;min-height:52px}
</style>
</head>
<body>
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5DGT9H6L"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->

<div class="kb-page">

<header class="kb-header">
  <div class="kb-header__bar">
    <a class="kb-brand" href="{{ p.url }}">
      <span>
        <span class="kb-brand__name">KOBE BEEF</span>
      </span>
    </a>
    <div class="kb-header__actions">
      <details class="kb-lang">
        <summary aria-label="{{ t.language }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg>
          {{ p.langMeta.short }}
        </summary>
        <ul class="kb-lang__list">
          {%- for a in p.alternates %}
          <li><a href="{{ a.href }}" hreflang="{{ a.hreflang }}" lang="{{ a.hreflang }}"{% if a.current %} aria-current="true"{% endif %}>{{ a.name }}{% if a.current %}<span aria-hidden="true">✓</span>{% endif %}</a></li>
          {%- endfor %}
        </ul>
      </details>
      <a class="kb-cta kb-cta--sm" href="{{ p.reserve.href }}" {{ reserveAttrs | safe }} data-ga-event="{{ p.reserve.event }}" data-ga-location="header">{{ p.reserve.short }}</a>
    </div>
    <p class="kb-header__store">{{ store.fullName }}</p>
  </div>
  <nav class="kb-nav" aria-label="Page sections">
    <a href="#menu">{{ t.navMenu }}</a>
    <a href="#halal">{{ t.navHalal }}</a>
    <a href="#access">{{ t.navAccess }}</a>
    <a href="#reserve">{{ t.navBooking }}</a>
  </nav>
</header>

<main>
<section>
  <img class="kb-hero__img" src="/image/kobe/{{ store.heroImage }}" alt="{{ p.h1 }}" width="1200" height="800">
  <div class="kb-hero__body">
    <span class="kb-kicker">{{ store.areaLabel }} · {{ t.city }}</span>
    <h1 class="kb-h1">{{ p.h1 }}</h1>
    <div class="kb-rule"></div>
    <span class="kb-badge">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
      {{ t.halalBadge }}
    </span>
    <div class="kb-chips">
      {%- for c in p.cats %}<span class="kb-chip">{{ c.title }}</span>{% endfor %}
    </div>
    {%- if not store.hideGoogleLinks and store.mapPlaceUrl %}
    <a href="{{ store.mapPlaceUrl }}" target="_blank" rel="noopener noreferrer" data-ga-event="map_click" data-ga-location="hero">★ {{ t.seeReviews }}</a>
    {%- endif %}
    <a class="kb-cta" href="{{ p.reserve.href }}" {{ reserveAttrs | safe }} data-ga-event="{{ p.reserve.event }}" data-ga-location="hero">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
      {{ p.reserve.label }}
    </a>
    {%- if p.hasReserveUrl %}<span class="kb-note">{{ t.reserveNote }}</span>{% endif %}
    <div class="kb-pair">
      {%- if p.hasReserveUrl %}
      <a class="kb-ghost" href="{{ store.phoneHref }}" data-ga-event="tel_click" data-ga-location="hero">{{ t.call }}</a>
      {%- else %}
      <a class="kb-ghost" href="#menu">{{ t.menu }}</a>
      {%- endif %}
      <a class="kb-ghost" href="{{ store.mapPlaceUrl }}" target="_blank" rel="noopener noreferrer" data-ga-event="map_click" data-ga-location="hero">{{ t.directions }}</a>
    </div>
  </div>
</section>

<section class="kb-info" aria-label="Store information">
  <div><span>{{ t.hours }}</span><strong>{{ store.hoursFull }}</strong></div>
  <div><span>{{ (p.firstStation.name if p.walkText else t.navAccess) if p.firstStation else t.navAccess }}</span><strong>{{ p.walkText if p.walkText else (p.firstStation.name if p.firstStation else '') }}</strong></div>
  <div><span>{{ t.dietary }}</span><strong>{{ t.dietaryValue }}</strong></div>
</section>

<section id="menu" class="kb-section">
  <h2 class="kb-h2">{{ t.menu }}</h2>
  <div class="kb-cards">
    {%- for c in p.cats %}
    <article class="kb-card">
      <img src="/image/kobe/{{ c.img }}" alt="{{ c.title }}" width="1200" height="750" loading="lazy">
      <div class="kb-card__body">
        <h3 class="kb-card__title" style="margin:0">{{ c.title }}</h3>
        <p class="kb-card__desc" style="margin:0">{{ c.desc }}</p>
      </div>
    </article>
    {%- endfor %}
    {%- if p.hasCombo %}<p class="kb-combo" style="margin:0">{{ t.comboNote }}</p>{% endif %}
  </div>
  <p class="kb-halal-note">{{ t.halalNote }}</p>
  <a class="kb-cta" href="{{ p.reserve.href }}" {{ reserveAttrs | safe }} data-ga-event="{{ p.reserve.event }}" data-ga-location="entry_menu">{{ p.reserve.label }}</a>
</section>

<section id="halal" class="kb-section kb-section--alt">
  <h2 class="kb-h2">{{ t.about }}</h2>
  <p style="margin:0">{{ p.aboutBody }}</p>
  <div class="kb-about-grid">
    {%- for card in t.aboutCards %}
    <div><strong>{{ card[0] }}</strong><span>{{ card[1] }}</span></div>
    {%- endfor %}
  </div>
</section>

{%- if not store.hideGoogleLinks and store.mapPlaceUrl %}
<section id="reviews" class="kb-section">
  <h2 class="kb-h2">{{ t.reviews }}</h2>
  <p style="margin:0;color:var(--muted)">{{ t.reviewsBody }}</p>
  <a class="kb-ghost" href="{{ store.mapPlaceUrl }}" target="_blank" rel="noopener noreferrer" data-ga-event="map_click" data-ga-location="entry_reviews">{{ t.seeReviews }}</a>
</section>
{%- endif %}

<section id="access" class="kb-section kb-section--alt">
  <h2 class="kb-h2">{{ t.access }}</h2>
  <div class="kb-table">
    <div><span>{{ t.hours }}</span><strong>{{ store.hoursFull }}</strong></div>
    {%- for s in store.stations %}
    <div><span>{{ s.name }}<br><small style="color:var(--muted)">{{ s.line }}</small></span><strong>{{ s.walk }}</strong></div>
    {%- endfor %}
  </div>
  {%- if store.mapEmbedUrl and not store.hideGoogleLinks %}
  <iframe class="kb-map" src="{{ store.mapEmbedUrl }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="{{ store.fullName }}" allowfullscreen></iframe>
  {%- endif %}
  <div class="kb-address">
    <strong>{{ store.addressHtml | safe }}</strong>
  </div>
  <a class="kb-ghost" href="{{ store.mapPlaceUrl }}" target="_blank" rel="noopener noreferrer" data-ga-event="map_click" data-ga-location="entry_access">{{ t.openMaps }}</a>
</section>

<section id="reserve" class="kb-section">
  <h2 class="kb-h2" style="color:#FFFFFF;border-bottom:0;padding-bottom:0">{{ p.reserveTitle }}</h2>
  <div class="kb-table">
    <div><span>{{ t.hours }}</span><strong>{{ store.hoursFull }}</strong></div>
  </div>
  <a class="kb-cta" href="{{ p.reserve.href }}" {{ reserveAttrs | safe }} data-ga-event="{{ p.reserve.event }}" data-ga-location="reservation_section">{{ p.reserve.label }}</a>
  <span class="kb-note">{{ t.dietNote }}</span>
  {%- if p.hasReserveUrl %}
  <span style="text-align:center;font-size:14px;color:var(--muted)">{{ t.preferCall }} <a href="{{ store.phoneHref }}" data-ga-event="tel_click" data-ga-location="reservation_section">{{ store.phone }}</a></span>
  {%- endif %}
  <div class="kb-faq">
    {%- for q in t.faq %}
    <details><summary>{{ q[0] }}</summary><p>{{ q[1] }}</p></details>
    {%- endfor %}
  </div>
</section>
</main>

<footer class="kb-footer">
  <a class="kb-cta" href="{{ p.reserve.href }}" {{ reserveAttrs | safe }} data-ga-event="{{ p.reserve.event }}" data-ga-location="footer">{{ p.reserve.label }}</a>
  <div>
    <strong>{{ store.fullName }}</strong><br>
    {{ store.addressHtml | safe }}<br>
    <a href="{{ store.phoneHref }}" data-ga-event="tel_click" data-ga-location="footer">{{ store.phone }}</a>
  </div>
  <a href="{{ ig }}" target="_blank" rel="noopener" data-ga-event="outbound_click" data-ga-location="footer">Instagram</a>
</footer>

</div>

<div class="kb-float">
  <div class="kb-float__inner">
    {%- if p.hasReserveUrl %}
    <a class="kb-float__tel" href="{{ store.phoneHref }}" aria-label="{{ t.call }}" data-ga-event="tel_click" data-ga-location="float_cta">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
    </a>
    {%- endif %}
    <a class="kb-cta" href="{{ p.reserve.href }}" {{ reserveAttrs | safe }} data-ga-event="{{ p.reserve.event }}" data-ga-location="float_cta">{{ p.reserve.label }}</a>
  </div>
</div>

<script>
/* === クリック計測（data-ga-event → dataLayer → GTM → GA4）===
   計測したい要素に data-ga-event="イベント名" を付けるだけ。dataLayer.push はここと head の2か所のみ。 */
window.dataLayer = window.dataLayer || [];
document.addEventListener('click', function (e) {
  var el = e.target.closest('[data-ga-event]');
  if (!el) return;
  window.dataLayer.push({
      event: el.getAttribute('data-ga-event'),
      event_label: (el.getAttribute('data-ga-location') || ''),
      store_name: '{{ store.gaStoreName }}',
      store_area: '{{ store.region }}',
      brand: 'kobe-beef',
      channel: 'map'
    });
}, true);
</script>

