}
.fm-foot .fm-cta:hover { background: var(--vermilion-deep); }

/* ============ FROM MIYAZAKI ============ */
.farm {
  background: var(--light-paper-warm);
  color: var(--light-ink);
  padding: 120px 0 130px;
  position: relative;
  overflow: hidden;
}
.farm::before {
  content: '';
  position: absolute;
  top: 0; left: 50%;
  transform: translateX(-50%);
  width: 80px; height: 1px;
  background: var(--vermilion);
}
.farm::after {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse at 20% 10%, rgba(168, 134, 46, 0.06), transparent 60%),
    radial-gradient(ellipse at 90% 80%, rgba(185, 28, 28, 0.04), transparent 60%);
  pointer-events: none;
}
.farm-inner { position: relative; z-index: 1; }
.farm-header { text-align: center; max-width: 760px; margin: 0 auto 60px; }
.farm-header .eyebrow { color: var(--light-ink-soft); justify-content: center; }
.farm-header .eyebrow::before { background: var(--vermilion); }
.farm-header h2 {
  font-family: 'Shippori Mincho', serif;
  font-size: clamp(34px, 5vw, 56px);
  font-weight: 600;
  line-height: 1.3;
  margin: 18px 0 18px;
  letter-spacing: 0.02em;
  color: var(--light-ink);
}
.farm-header h2 .accent { color: var(--vermilion); }
.farm-header .en-sub {
  display: block;
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-size: 18px;
  color: var(--light-gold);
  letter-spacing: 0.12em;
  margin-top: 12px;
  font-weight: 400;
}

.farm-visual {
  position: relative;
  margin: 0 -32px 64px;
  border-radius: 2px;
  overflow: hidden;
  aspect-ratio: 21 / 9;
  background-color: #2a2017;
}
.farm-visual img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 8s ease-out;
}
.farm-visual:hover img { transform: scale(1.05); }
.farm-visual .caption {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24px 32px 20px;
  background: linear-gradient(180deg, transparent, rgba(0,0,0,0.75));
  color: var(--cream);
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-size: 15px;
  letter-spacing: 0.12em;
}
.farm-visual .caption strong {
  font-family: 'Shippori Mincho', serif;
  font-style: normal;
  font-size: 17px;
  font-weight: 600;
  margin-right: 12px;
  color: var(--gold-pale);
  letter-spacing: 0.08em;
}

.farm-points {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  margin-bottom: 56px;
  border-top: 1px solid var(--light-line);
  border-bottom: 1px solid var(--light-line);
}
.farm-point { padding: 40px 24px; text-align: center; border-right: 1px solid var(--light-line); }
.farm-point:last-child { border-right: none; }
.farm-point-num {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-size: clamp(40px, 5vw, 56px);
  color: var(--vermilion);
  line-height: 1;
  margin-bottom: 14px;
  font-weight: 500;
}
.farm-point-num.jp {
  font-family: 'Shippori Mincho', serif;
  font-style: normal;
  font-size: clamp(28px, 3.5vw, 42px);
  color: var(--light-ink);
  font-weight: 600;
}
.farm-point-num.en-place {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-size: clamp(28px, 3.5vw, 42px);
  color: var(--light-ink);
  font-weight: 500;
  letter-spacing: 0.01em;
}
.farm-point-label {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-size: 13px;
  letter-spacing: 0.22em;
  color: var(--light-gold);
  text-transform: uppercase;
  margin-bottom: 10px;
}
.farm-point-desc {
  font-size: 13.5px;
  color: var(--light-ink-soft);
  line-height: 1.7;
  letter-spacing: 0.03em;
}

.farm-body { max-width: 720px; margin: 0 auto; text-align: center; }
.farm-body p {
  font-size: 15.5px;
  line-height: 2;
  color: var(--light-ink);
  letter-spacing: 0.04em;
  margin-bottom: 18px;
}
.farm-body p:last-child { margin-bottom: 0; }
.farm-body strong { color: var(--vermilion); font-weight: 600; }

/* ============ OUR PROMISE ============ */
.promise {
  background: var(--paper-warm);
  color: var(--cream);
  position: relative;
  overflow: hidden;
  padding: 130px 0;
}
.promise::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse at 80% 30%, rgba(185, 28, 28, 0.18), transparent 60%),
    radial-gradient(ellipse at 20% 70%, rgba(201, 163, 90, 0.08), transparent 60%);
  pointer-events: none;
}
.promise-inner { position: relative; z-index: 2; }
.promise-header { text-align: center; margin-bottom: 60px; }
.promise-header .eyebrow { color: var(--gold); justify-content: center; }
.promise-header h2 {
  font-family: 'Shippori Mincho', serif;
  font-size: clamp(34px, 4.5vw, 56px);
  line-height: 1.3;
  font-weight: 600;
  margin-top: 24px;
  color: var(--cream);
}
.promise-header h2 .accent { color: var(--vermilion); }
.promise-header p {
  font-size: 16px;
  line-height: 1.95;
  color: var(--ink-soft);
  margin-top: 28px;
  max-width: 680px;
  margin-left: auto;
  margin-right: auto;
  font-weight: 300;
}
.promise-header p strong { color: var(--gold-pale); font-weight: 500; }
.promise-gallery {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr;
  gap: 16px;
  margin-top: 50px;
}
.promise-photo { position: relative; overflow: hidden; min-height: 380px; }
.promise-photo img,
.promise-photo video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.8s ease;
}
.promise-photo:hover img,
.promise-photo:hover video { transform: scale(1.05); }
.promise-photo.is-video::before {
  content: '▶ VIDEO';
  position: absolute;
  top: 14px;
  right: 14px;
  z-index: 3;
  font-family: 'Cormorant Garamond', serif;
  font-size: 11px;
  letter-spacing: 0.2em;
  color: var(--cream);
  background: rgba(10, 8, 7, 0.55);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  padding: 5px 10px;
  border: 1px solid rgba(201, 163, 90, 0.35);
  border-radius: 2px;
}
.promise-photo .caption {
  position: absolute;
  bottom: 16px;
  left: 18px;
  right: 18px;
  z-index: 2;
  color: var(--cream);
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-size: 18px;
  letter-spacing: 0.03em;
  text-shadow: 0 2px 8px rgba(0,0,0,0.8);
}
.promise-photo::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 50%, rgba(10, 8, 7, 0.7) 100%);
  pointer-events: none;
}
.promise-mark {
  display: block;
  text-align: center;
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  color: var(--gold);
  font-size: 15px;
  line-height: 1.6;
  max-width: 540px;
  margin: 50px auto 0;
  letter-spacing: 0.04em;
}
.promise-mark::before { content: '— '; }
.promise-mark::after { content: ' —'; }

/* ============ MUSLIM-FRIENDLY ============ */
section.halal { padding: 130px 0; background: var(--paper-warm); position: relative; }
.halal-header { text-align: center; margin-bottom: 70px; }
.halal-header .eyebrow { justify-content: center; }
.halal-header h2 {
  font-family: 'Shippori Mincho', serif;
  font-size: clamp(34px, 4.5vw, 56px);
  font-weight: 600;
  margin-top: 24px;
  line-height: 1.3;
  color: var(--cream);
}
.halal-header h2 .accent { color: var(--vermilion); }
.halal-header p {
  font-size: 15px;
  color: var(--ink-soft);
  margin-top: 24px;
  max-width: 560px;
  margin-left: auto;
  margin-right: auto;
  font-weight: 300;
  line-height: 1.85;
}
.halal-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: var(--line);
  border: 1px solid var(--line);
}
.halal-item { background: var(--paper-warm); padding: 42px 32px; text-align: center; }
.halal-icon {
  width: 56px;
  height: 56px;
  margin: 0 auto 20px;
  border: 1px solid var(--gold);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--gold);
}
.halal-icon svg { width: 26px; height: 26px; }
.halal-item h3 {
  font-family: 'Shippori Mincho', serif;
  font-size: 19px;
  font-weight: 600;
  margin-bottom: 12px;
  color: var(--cream);
}
.halal-item p {
  font-size: 13px;
  color: var(--ink-soft);
  line-height: 1.75;
  font-weight: 300;
}
.halal-details { margin-top: 40px; text-align: center; }
.halal-details summary {
  display: inline-block;
  cursor: pointer;
  font-size: 13px;
  letter-spacing: 0.14em;
  font-weight: 600;
  color: var(--gold);
  border-bottom: 1px solid var(--gold);
  padding-bottom: 4px;
  list-style: none;
  transition: color 0.3s;
}
.halal-details summary:hover { color: var(--gold-pale); }
.halal-details summary::-webkit-details-marker { display: none; }
.halal-details[open] summary::after { content: ' ▴'; }
.halal-details:not([open]) summary::after { content: ' ▾'; }
.halal-details-content {
  margin-top: 28px;
  max-width: 680px;
  margin-left: auto;
  margin-right: auto;
  font-size: 15px;
  line-height: 1.95;
  color: var(--ink-soft);
  font-weight: 300;
  text-align: left;
}

/* ============ WHY HERE (stats) ============ */
/* 改修: 背景動画を削除し、単色背景に。storyBgImage 指定時のみ JS が画像を当てる */
.why {
  padding: 110px 0;
  position: relative;
  overflow: hidden;
  color: var(--cream);
  background: var(--paper-warm);
}
.why-overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background:
    radial-gradient(ellipse at 80% 30%, rgba(185, 28, 28, 0.12), transparent 60%),
    radial-gradient(ellipse at 20% 70%, rgba(201, 163, 90, 0.06), transparent 60%);
}
/* storyBgImage が入った時だけ暗いオーバーレイを強める */
.why--has-image .why-overlay {
  background:
    linear-gradient(180deg, rgba(10, 8, 7, 0.55) 0%, rgba(10, 8, 7, 0.4) 50%, rgba(10, 8, 7, 0.7) 100%);
}
.why > .container { position: relative; z-index: 2; }
.why-header { text-align: center; margin-bottom: 70px; }
.why-header .eyebrow { justify-content: center; color: var(--ink-soft); }
.why-header .eyebrow::before { background: var(--vermilion); }
.why-header h2 {
  font-family: 'Shippori Mincho', serif;
  font-size: clamp(34px, 4.5vw, 56px);
  font-weight: 600;
  margin-top: 24px;
  line-height: 1.3;
  color: var(--cream);
}
.why-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; }
.why-item { text-align: center; padding: 40px 24px; border-right: 1px solid var(--line); }
.why-item:last-child { border-right: none; }
.why-num {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(56px, 8vw, 104px);
  line-height: 1;
  font-weight: 400;
  color: var(--gold-bright);
  margin-bottom: 16px;
  letter-spacing: -0.03em;
  text-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
}
.why-num .small { font-size: 0.4em; color: var(--vermilion); vertical-align: super; margin-left: 4px; }
.why-num.jp {
  font-family: 'Shippori Mincho', serif;
  font-size: clamp(38px, 5vw, 64px);
  font-weight: 600;
  color: var(--cream);
}
.why-num.en-word {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-size: clamp(46px, 6vw, 76px);
  font-weight: 500;
  color: var(--cream);
  letter-spacing: 0.02em;
}
.why-label { font-size: 12px; letter-spacing: 0.2em; color: var(--gold); font-weight: 500; margin-bottom: 10px; }
.why-desc {
  font-size: 13px;
  color: var(--ink-soft);
  line-height: 1.7;
  max-width: 220px;
  margin: 0 auto;
  font-weight: 300;
}

/* ============ REVIEWS ============ */
.reviews { padding: 110px 0; background: var(--paper); color: var(--cream); }
.reviews-header { text-align: center; margin-bottom: 60px; }
.reviews-header .eyebrow { justify-content: center; color: var(--gold); }
.reviews-score {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(72px, 11vw, 140px);
  line-height: 1;
  font-weight: 400;
  margin: 28px 0 8px;
  letter-spacing: -0.03em;
  color: var(--gold);
}
.reviews-score .out { color: rgba(201, 163, 90, 0.4); font-size: 0.45em; margin-left: 8px; }
.reviews-stars { color: var(--gold); font-size: 18px; letter-spacing: 6px; margin-bottom: 14px; }
.reviews-count { font-size: 12px; letter-spacing: 0.18em; color: rgba(245, 241, 234, 0.55); }
.reviews-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-bottom: 50px; }
.review-card { border: 1px solid rgba(245, 241, 234, 0.15); padding: 32px 28px; }
.review-card .quote-mark {
  font-family: 'Cormorant Garamond', serif;
  font-size: 60px;
  line-height: 0.7;
  color: var(--vermilion);
  margin-bottom: 16px;
  display: block;
}
.review-quote {
  font-family: 'Shippori Mincho', serif;
  font-size: 17px;
  line-height: 1.8;
  margin-bottom: 28px;
  font-weight: 400;
}
.review-author {
  display: flex;
  align-items: center;
  gap: 12px;
  padding-top: 20px;
  border-top: 1px solid rgba(245, 241, 234, 0.15);
}
.review-flag {
  width: 34px;
  height: 34px;
  background: var(--vermilion);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  font-weight: 700;
  color: var(--cream);
  letter-spacing: 0.05em;
}
.review-name { font-size: 13px; font-weight: 600; letter-spacing: 0.04em; }
.review-loc { font-size: 11px; color: rgba(245, 241, 234, 0.5); letter-spacing: 0.1em; }
.reviews-cta { text-align: center; }
.reviews-cta a {
  color: var(--cream);
  text-decoration: none;
  border-bottom: 1px solid rgba(245, 241, 234, 0.4);
  padding-bottom: 4px;
  font-size: 12px;
  letter-spacing: 0.14em;
  font-weight: 600;
}

/* ============ ACCESS ============ */
.access { padding: 130px 0; background: var(--light-paper); color: var(--light-ink); }
.access-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 60px; align-items: start; }
.access-info .eyebrow { color: var(--light-ink-soft); }
.access-info .eyebrow::before { background: var(--vermilion); }
.access-info h2 {
  font-family: 'Shippori Mincho', serif;
  font-size: clamp(34px, 4.5vw, 52px);
  font-weight: 600;
  line-height: 1.3;
  margin: 24px 0 36px;
  color: var(--light-ink);
}
.access-info h2 .accent { color: var(--vermilion); }
.access-block { margin-bottom: 28px; padding-bottom: 24px; border-bottom: 1px solid var(--light-line); }
.access-block:last-child { border-bottom: none; }
.access-block-label {
  font-size: 11px;
  letter-spacing: 0.2em;
  color: var(--light-gold);
  margin-bottom: 10px;
  font-weight: 600;
}
.access-block p { font-size: 16px; line-height: 1.75; color: var(--light-ink); font-weight: 400; }
.access-stations { list-style: none; }
.access-stations li {
  display: flex;
  justify-content: space-between;
  padding: 9px 0;
  font-size: 15px;
  color: var(--light-ink);
}
.access-stations .walk {
  color: var(--light-gold);
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-weight: 500;
  letter-spacing: 0.05em;
}
.access-amenities { list-style: none; }
.access-amenities li {
  position: relative;
  padding: 7px 0 7px 22px;
  font-size: 15px;
  color: var(--light-ink);
  line-height: 1.6;
}
.access-amenities li::before {
  content: '';
  position: absolute;
  left: 2px;
  top: 15px;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--light-gold);
}
/* 改修: マップを正方形に。縦長になりすぎないよう aspect-ratio で固定し、sticky で上に追従 */
.access-map {
  background: var(--light-paper-warm);
  aspect-ratio: 1 / 1;
  position: relative;
  overflow: hidden;
  border: 1px solid var(--light-line);
  position: sticky;
  top: 100px;
}
.access-map iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
/* 地図を隠したとき（hideGoogleLinks）はグリッドを1カラムにして左情報が間延びしないようにする */
.access-grid.is-map-hidden { grid-template-columns: 1fr; max-width: 640px; }
.access-grid.is-map-hidden .access-map { display: none; }

/* ============ FAQ ============ */
.faq { padding: 110px 0; background: var(--paper); }
.faq-grid { display: grid; grid-template-columns: 1fr 2fr; gap: 80px; }
.faq-header h2 {
  font-family: 'Shippori Mincho', serif;
  font-size: clamp(34px, 4.5vw, 52px);
  font-weight: 600;
  line-height: 1.3;
  margin-top: 24px;
  color: var(--cream);
}
.faq-list { display: flex; flex-direction: column; }
.faq-item { border-bottom: 1px solid var(--line); padding: 24px 0; }
.faq-item:first-child { border-top: 1px solid var(--line); }
.faq-q {
  font-family: 'Shippori Mincho', serif;
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 12px;
  display: flex;
  align-items: baseline;
  gap: 14px;
  color: var(--cream);
}
.faq-q::before {
  content: 'Q.';
  color: var(--vermilion);
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-size: 20px;
  font-weight: 500;
}
.faq-a {
  font-size: 14.5px;
  line-height: 1.85;
  color: var(--ink-soft);
  padding-left: 30px;
  font-weight: 300;
}
.faq-a strong { color: var(--gold-pale) !important; font-weight: 500 !important; }
.faq-cancel { margin-top: 14px; padding: 14px 18px; background: var(--paper-warm); border-left: 2px solid var(--gold); }
.faq-cancel-row { display: flex; justify-content: space-between; padding: 6px 0; font-size: 13px; }
.faq-cancel-row:not(:last-child) { border-bottom: 1px dashed rgba(201, 163, 90, 0.2); }
.faq-cancel-time { color: var(--cream); font-weight: 500; }
.faq-cancel-time .en { color: var(--muted); font-size: 12px; }
.faq-cancel-fee {
  color: var(--gold);
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-size: 15px;
}

/* ============ FINAL CTA ============ */
.final {
  background-color: var(--paper);
  background-image:
    linear-gradient(180deg, rgba(10, 8, 7, 0.55) 0%, rgba(20, 8, 8, 0.4) 50%, rgba(10, 8, 7, 0.7) 100%),
    url('/image/skytree-sakura.jpg');
  background-size: cover;
  background-position: center 30%;
  background-repeat: no-repeat;
  color: var(--cream);
  padding: 130px 0 100px;
  position: relative;
  overflow: hidden;
  text-align: center;
}
.final::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse at 50% 30%, rgba(185, 28, 28, 0.15), transparent 65%),
    radial-gradient(ellipse at 50% 90%, rgba(201, 163, 90, 0.1), transparent 60%);
  z-index: 1;
  pointer-events: none;
