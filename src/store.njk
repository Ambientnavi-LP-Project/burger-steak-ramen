<script src="/store-render.js"></script>

<!-- Scripts -->
<script>
/* ============================================================
 * Wagyu Beef (Halal) Steak Hamburger & Ramen ... 5W-Tokyo 1962 - JavaScript
 * ============================================================ */

// ============================================================
// Hero slideshow (5 images, cross-fade)
// ============================================================
(function initHeroSlideshow() {
  const slides = document.querySelectorAll('.hero-slide');
  if (slides.length < 2) return;
  let idx = 0;
  setInterval(() => {
    slides[idx].classList.remove('is-active');
    idx = (idx + 1) % slides.length;
    slides[idx].classList.add('is-active');
  }, 4500);
})();

// ============================================================
// Fade-in on scroll
// ============================================================
(function initReveal() {
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('in');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
})();

// ============================================================
// Hide floating bar & nudge when FINAL CTA is visible
// ============================================================
(function initFloatingHide() {
  const bar = document.getElementById('floatingBar');
  const nudge = document.getElementById('nudgeToast');
  const finalBtn = document.querySelector('.final-primary');
  if (!finalBtn) return;
  const ctaObserver = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      const inView = e.isIntersecting;
      if (bar) {
        bar.classList.toggle('is-hidden', inView);
      }
      if (nudge) {
        nudge.classList.toggle('is-hidden', inView);
      }
    });
  }, { threshold: 0.01 });
  ctaObserver.observe(finalBtn);
})();

// ============================================================
// Tab switching (full menu)
// ============================================================
(function initTabs() {
  const tabs = document.querySelectorAll('.fm-tab');
  const panels = document.querySelectorAll('.fm-panel');
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const key = tab.dataset.tab;
      tabs.forEach(t => t.classList.toggle('is-active', t === tab));
      panels.forEach(p => p.classList.toggle('is-active', p.dataset.panel === key));
    });
  });
})();

// ============================================================
// NUDGE TOAST (after 6s, once per session)
// ============================================================
(function initNudgeToast() {
  const toast = document.getElementById('nudgeToast');
  if (!toast) return;
  if (sessionStorage.getItem('nudgeShown')) return;
  let shown = false;
  setTimeout(() => {
    const reserve = document.getElementById('reserve');
    if (reserve) {
      const rect = reserve.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) return;
    }
    toast.classList.add('is-shown');
    shown = true;
    sessionStorage.setItem('nudgeShown', '1');
    setTimeout(() => {
      if (shown) toast.classList.add('is-hidden');
    }, 12000);
  }, 6000);
})();

// ============================================================
// EXIT INTENT MODAL (once per session, desktop only)
// ============================================================
(function initExitModal() {
  const modal = document.getElementById('exitModal');
  if (!modal) return;
  if (sessionStorage.getItem('exitShown')) return;
  if (window.matchMedia('(hover: none)').matches) return;
  // 開いてから 20 秒間は exit-intent を無効化（誤発火防止＋閲覧時間の確保）
  const startTime = Date.now();
  function onLeave(e) {
    if (Date.now() - startTime < 20000) return;
    if (e.clientY > 0) return;
    if (sessionStorage.getItem('exitShown')) return;
    sessionStorage.setItem('exitShown', '1');
    modal.classList.add('is-shown');
    document.removeEventListener('mouseleave', onLeave);
  }
  document.addEventListener('mouseleave', onLeave);
})();

function closeExitModal() {
  const m = document.getElementById('exitModal');
  if (m) m.classList.remove('is-shown');
}
window.closeExitModal = closeExitModal;

// ============================================================
// VIDEO: play only when in view (saves power & bandwidth)
// ============================================================
(function initLazyVideo() {
  const videos = document.querySelectorAll('.promise-photo video');
  if (!videos.length || !('IntersectionObserver' in window)) return;
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      const v = e.target;
      if (e.isIntersecting) {
        const p = v.play();
        if (p && typeof p.catch === 'function') p.catch(() => {});
      } else {
        v.pause();
      }
    });
  }, { threshold: 0.25 });
  videos.forEach((v) => io.observe(v));
})();

</script>

</body>
</html>
