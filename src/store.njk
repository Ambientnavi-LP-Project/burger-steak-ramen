/* ============ NUDGE TOAST ============ */
.nudge-toast {
  position: fixed;
  bottom: 110px;
  left: 50%;
  transform: translateX(-50%) translateY(20px);
  z-index: 95;
  width: min(360px, calc(100% - 32px));
  padding: 16px 42px 16px 20px;
  background: rgba(20, 14, 11, 0.96);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid rgba(201, 163, 90, 0.35);
  border-left: 3px solid var(--vermilion);
  border-radius: 6px;
  color: var(--cream);
  box-shadow: 0 14px 40px rgba(0, 0, 0, 0.55);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.5s ease, transform 0.5s ease;
}
.nudge-toast.is-shown {
  opacity: 1;
  pointer-events: auto;
  transform: translateX(-50%) translateY(0);
}
.nudge-toast.is-hidden { opacity: 0; pointer-events: none; transform: translateX(-50%) translateY(20px); }
.nudge-toast-title {
  font-family: 'Shippori Mincho', serif;
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 4px;
  color: var(--gold-pale);
  letter-spacing: 0.05em;
}
.nudge-toast-body {
  font-size: 12.5px;
  color: rgba(245, 241, 234, 0.85);
  line-height: 1.6;
  letter-spacing: 0.03em;
}
.nudge-toast-body .en {
  display: block;
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-size: 11.5px;
  color: rgba(201, 163, 90, 0.8);
  letter-spacing: 0.05em;
  margin-top: 4px;
}

/* ============ EXIT INTENT MODAL ============ */
.exit-modal {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: none;
  align-items: center;
  justify-content: center;
  background: rgba(10, 8, 7, 0.78);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  padding: 24px;
  opacity: 0;
  transition: opacity 0.4s ease;
}
.exit-modal.is-shown { display: flex; opacity: 1; }
.exit-modal-card {
  position: relative;
  background: var(--paper);
  border: 1px solid rgba(201, 163, 90, 0.35);
  border-top: 3px solid var(--vermilion);
  padding: 80px 44px 44px;
  max-width: 520px;
  width: 100%;
  text-align: center;
  overflow: hidden;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.7);
  transform: translateY(20px);
  transition: transform 0.4s ease;
}
.exit-modal-media { position: absolute; inset: 0; z-index: 0; overflow: hidden; }
.exit-modal-media img,
.exit-modal-media video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  animation: kenBurns 18s ease-in-out infinite alternate;
}
@keyframes kenBurns {
  from { transform: scale(1) translate(0, 0); }
  to   { transform: scale(1.08) translate(-1%, -1%); }
}
.exit-modal-media::after {
  content: '';
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(10, 8, 7, 0.65) 0%, rgba(10, 8, 7, 0.92) 100%),
    radial-gradient(ellipse at 50% 50%, rgba(10, 8, 7, 0.55), rgba(10, 8, 7, 0.92));
}
.exit-modal-card > *:not(.exit-modal-media) {
  position: relative;
  z-index: 2;
}
.exit-modal.is-shown .exit-modal-card { transform: translateY(0); }
.exit-modal-eyebrow {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  color: var(--gold);
  font-size: 13px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  margin-bottom: 16px;
}
.exit-modal-title {
  font-family: 'Shippori Mincho', serif;
  font-size: 22px;
  font-weight: 600;
  color: var(--cream);
  line-height: 1.5;
  margin-bottom: 14px;
  letter-spacing: 0.02em;
}
.exit-modal-title .accent { color: var(--vermilion); }
.exit-modal-body {
  font-size: 13px;
  color: rgba(245, 241, 234, 0.78);
  line-height: 1.85;
  margin-bottom: 28px;
  letter-spacing: 0.03em;
}
.exit-modal-body .en {
  display: block;
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-size: 12.5px;
  color: rgba(201, 163, 90, 0.85);
  margin-top: 6px;
}
.exit-modal-cta {
  display: inline-block;
  padding: 14px 34px;
  background: var(--vermilion);
  color: var(--cream);
  text-decoration: none;
  font-family: 'Shippori Mincho', serif;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.16em;
  border-radius: 2px;
  transition: background 0.25s;
}
.exit-modal-cta:hover { background: var(--vermilion-deep); }
.exit-modal-skip {
  display: block;
  margin: 16px auto 0;
  background: transparent;
  border: none;
  color: rgba(245, 241, 234, 0.75);
  font-size: 12px;
  letter-spacing: 0.08em;
  cursor: pointer;
  text-decoration: underline;
  text-underline-offset: 3px;
  padding: 8px 12px;
  text-align: center;
  transition: color 0.2s;
}
.exit-modal-skip:hover { color: var(--cream); }

/* ============ ANIMATIONS ============ */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24px); }
  to   { opacity: 1; transform: translateY(0); }
}
.hero-eyebrow { animation: fadeUp 0.7s ease 0.1s both; }
.hero-info    { animation: fadeUp 0.7s ease 0.2s both; }
.info-station { animation: fadeUp 0.7s ease 0.3s both; }
.hero h1     { animation: fadeUp 0.9s ease 0.4s both; }
.hero-sub    { animation: fadeUp 0.8s ease 0.55s both; }
.hero-ctas   { animation: fadeUp 0.8s ease 0.7s both; }
.hero-trust  { animation: fadeUp 0.8s ease 0.85s both; }
.hero-social-proof { animation: fadeUp 0.8s ease 1.1s both; }

.reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.8s ease, transform 0.8s ease; }
.reveal.in { opacity: 1; transform: translateY(0); }

